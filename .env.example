COHORTSWITCH_APP_ENV=development
COHORTSWITCH_DATABASE_URL=postgresql+asyncpg://cohortswitch:cohortswitch@postgres:5432/cohortswitch
COHORTSWITCH_REDIS_URL=redis://redis:6379/0
COHORTSWITCH_JWT_SECRET=replace-with-at-least-32-random-characters
COHORTSWITCH_JWT_ACCESS_TTL_SECONDS=900
COHORTSWITCH_REFRESH_TOKEN_TTL_SECONDS=2592000
COHORTSWITCH_CORS_ORIGINS=["http://localhost:3000"]
COHORTSWITCH_TRUSTED_HOSTS=["localhost","127.0.0.1"]
COHORTSWITCH_CACHE_TTL_SECONDS=30
COHORTSWITCH_MANAGEMENT_RATE_LIMIT=60
COHORTSWITCH_SDK_RATE_LIMIT=1000
COHORTSWITCH_MAX_BODY_BYTES=1048576
COHORTSWITCH_LOG_LEVEL=INFO

